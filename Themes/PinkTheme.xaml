<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- =========================================================
         KATER1EQ - MELODY PINK THEME
         ========================================================= -->


	<!-- ===================== COLORS ====================== -->
	<!-- STEP: đồng bộ đúng theo bảng màu Figma (repo Kater1devU/AppBuilder, biến `C` trong
	     App.tsx). LƯU Ý: trong file gốc có khoảng 10 chỗ dùng màu magenta chói
	     rgb(247,0,255)/rgba(255,0,242,0.97) ở viền và chữ cảnh báo - đây không nằm trong bảng
	     màu `C` chính thức, nhìn giống màu placeholder/debug còn sót lại của Figma Make hơn là
	     chủ đích thiết kế, nên KHÔNG mang nguyên vào đây. Các chỗ đó map lại về WarningColor/
	     BorderColor cho nhất quán - nếu đây thực sự là màu bạn muốn giữ, nói lại để tôi đổi. -->

	<SolidColorBrush x:Key="BgPrimary"
                     Color="#A03060"/>

	<SolidColorBrush x:Key="BgCard"
                     Color="#CC6888"/>

	<SolidColorBrush x:Key="BgElevated"
                     Color="#EFB0C8"/>


	<SolidColorBrush x:Key="AccentColor"
                     Color="#E8357A"/>

	<SolidColorBrush x:Key="AccentColorDim"
                     Color="#F5C0D4"/>

	<!-- STEP: bổ sung Accent hover/pressed cho Pink theme - PixelStyles.xaml tham chiếu
	     {DynamicResource AccentHoverBrush}/AccentPressedBrush, trước đây chỉ có ở PixelTheme
	     nên theme Pink bị fallback sai màu. Hover sáng hơn, Pressed tối hơn AccentColor, cùng
	     tông đỏ-hồng #E8357A. -->
	<SolidColorBrush x:Key="AccentHoverBrush"
                     Color="#F05C93"/>

	<SolidColorBrush x:Key="AccentPressedBrush"
                     Color="#B8235C"/>

	<!-- STEP: màu bóng đổ cho DropShadowEffect của FilterEditorPanel (mục 1 audit) - đen
	     thuần, giống nhau ở cả 3 theme vì đây là bóng đổ vật lý, không phải màu trang trí
	     phụ thuộc theme. -->
	<Color x:Key="ShadowColor">#000000</Color>


	<!-- TextPrimary = đúng C.text trong file gốc (trùng giá trị AccentColor - bản thân file gốc
	     định nghĩa vậy, không phải tôi tự suy ra). Dùng cho input/label/text trong nút, card.
	     TextOnDark dùng riêng cho text trắng thuần (header title, nút chính) - file gốc override
	     tay bằng rgb(255,255,255) ở 1 số chỗ cụ thể thay vì dùng TextPrimary. -->
	<SolidColorBrush x:Key="TextPrimary"
                     Color="#E8357A"/>

	<SolidColorBrush x:Key="TextOnDark"
                     Color="#FFFFFF"/>

	<SolidColorBrush x:Key="TextSecondary"
                     Color="#FFE8F2"/>


	<SolidColorBrush x:Key="BorderColor"
                     Color="#F8C8D8"/>

	<SolidColorBrush x:Key="WarningColor"
                     Color="#FFD166"/>

	<!--
        ===== FONT (pixel, Minecraft-style) =====
        BUG FIX QUAN TRỌNG: trước đây dùng đường dẫn tương đối "./Assets/Fonts/#..." - nhưng
        file này (PinkTheme.xaml) nằm trong thư mục Themes/, nên WPF tính đường dẫn tương đối
        đó là TỪ Themes/ (ra Themes/Assets/Fonts/... - không tồn tại) chứ không phải từ gốc
        project. Đây là lý do font không bao giờ đổi được dù .csproj và file .ttf đã đúng. Sửa
        bằng pack URI TUYỆT ĐỐI (pack://application:,,,/...) - không phụ thuộc file khai báo nó
        nằm ở đâu, luôn tính từ gốc assembly.

        Bản quyền: KHÔNG dùng font chính thức Mojang ("Minecraft Seven"/"Mojangles") - không
        được phép nhúng vào app ngoài Minecraft. Dùng "Monocraft" (mã nguồn mở, MIT license):
        https://github.com/IdreesInc/Monocraft/releases - bỏ file .ttf thẳng vào
        Assets/Fonts/Monocraft.ttf (không để trong thư mục con).
    -->
	<FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Monocraft, Consolas, Segoe UI</FontFamily>

	<!-- STEP 8: alias để MainWindow (EQ curve) có thể FindResource("EQCurveBrush") an toàn ở
         mọi theme. Pink theme không tách màu curve riêng khỏi accent - trỏ thẳng về AccentColor. -->
	<StaticResource x:Key="EQCurveBrush" ResourceKey="AccentColor"/>
	<StaticResource x:Key="SelectedBorderBrush" ResourceKey="AccentColor"/>


	<!-- ===================== BUTTONS ====================== -->

	<Style x:Key="PrimaryButton"
           TargetType="Button">

		<Setter Property="Foreground"
                Value="#FFFFFF"/>

		<Setter Property="Background"
                Value="{StaticResource AccentColor}"/>

		<Setter Property="BorderThickness"
                Value="0"/>

		<Setter Property="FontSize"
                Value="12"/>

		<Setter Property="FontFamily"
                Value="{StaticResource AppFont}"/>

		<Setter Property="FontWeight"
                Value="SemiBold"/>

		<Setter Property="Padding"
                Value="18,9"/>

		<Setter Property="Cursor"
                Value="Hand"/>

		<Setter Property="Template">

			<Setter.Value>

				<ControlTemplate TargetType="Button">

					<Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

						<ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

					</Border>

					<ControlTemplate.Triggers>

						<Trigger Property="IsMouseOver"
                                 Value="True">

							<Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#FF5C97"/>

						</Trigger>

						<Trigger Property="IsPressed"
                                 Value="True">

							<Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#D91760"/>

						</Trigger>

						<Trigger Property="IsEnabled"
                                 Value="False">

							<Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.4"/>

						</Trigger>

					</ControlTemplate.Triggers>

				</ControlTemplate>

			</Setter.Value>

		</Setter>

	</Style>


	<!-- ================= SECONDARY BUTTON ================= -->

	<Style x:Key="SecondaryButton"
           TargetType="Button">

		<Setter Property="Foreground"
                Value="{StaticResource TextPrimary}"/>

		<Setter Property="Background"
                Value="{StaticResource BgElevated}"/>

		<Setter Property="BorderBrush"
                Value="{StaticResource BorderColor}"/>

		<Setter Property="BorderThickness"
                Value="1"/>

		<Setter Property="FontSize"
                Value="12"/>

		<Setter Property="FontFamily"
                Value="{StaticResource AppFont}"/>

		<Setter Property="Padding"
                Value="14,8"/>

		<Setter Property="Cursor"
                Value="Hand"/>

		<Setter Property="Template">

			<Setter.Value>

				<ControlTemplate TargetType="Button">

					<Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

						<ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

					</Border>

					<ControlTemplate.Triggers>

						<Trigger Property="IsMouseOver"
                                 Value="True">

							<Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#FBE6F0"/>

							<Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#FF2D78"/>

						</Trigger>

						<Trigger Property="IsPressed"
                                 Value="True">

							<Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#F6D2E6"/>

						</Trigger>

					</ControlTemplate.Triggers>

				</ControlTemplate>

			</Setter.Value>

		</Setter>

	</Style>


	<!-- ===================== TOGGLE ====================== -->

	<Style x:Key="EqToggleSwitch"
           TargetType="CheckBox">

		<Setter Property="Width"
                Value="44"/>

		<Setter Property="Height"
                Value="23"/>

		<Setter Property="Cursor"
                Value="Hand"/>

		<Setter Property="Template">

			<Setter.Value>

				<ControlTemplate TargetType="CheckBox">

					<Grid>

						<!-- Track -->

						<Border x:Name="Track"
                                Width="44"
                                Height="23"
                                CornerRadius="12"
                                Background="#FCE9F2"
                                BorderBrush="#F0C6DE"
                                BorderThickness="1"/>


						<!-- Thumb -->

						<Ellipse x:Name="Thumb"
                                 Width="17"
                                 Height="17"
                                 Fill="#E3A8C3"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0"/>

					</Grid>


					<ControlTemplate.Triggers>

						<!-- ON -->

						<Trigger Property="IsChecked"
                                 Value="True">

							<Setter TargetName="Track"
                                    Property="Background"
                                    Value="#FF2D78"/>

							<Setter TargetName="Track"
                                    Property="BorderBrush"
                                    Value="#FF5C97"/>

							<Setter TargetName="Thumb"
                                    Property="Fill"
                                    Value="#FFFFFF"/>

							<Setter TargetName="Thumb"
                                    Property="HorizontalAlignment"
                                    Value="Right"/>

							<Setter TargetName="Thumb"
                                    Property="Margin"
                                    Value="0,0,3,0"/>

						</Trigger>


						<!-- Hover -->

						<Trigger Property="IsMouseOver"
                                 Value="True">

							<Setter TargetName="Track"
                                    Property="BorderBrush"
                                    Value="#FF2D78"/>

						</Trigger>


						<!-- Disabled -->

						<Trigger Property="IsEnabled"
                                 Value="False">

							<Setter TargetName="Track"
                                    Property="Opacity"
                                    Value="0.4"/>

							<Setter TargetName="Thumb"
                                    Property="Opacity"
                                    Value="0.4"/>

						</Trigger>

					</ControlTemplate.Triggers>

				</ControlTemplate>

			</Setter.Value>

		</Setter>

	</Style>


	<!-- ===================== SLIDER ====================== -->

	<Style x:Key="EqVerticalSlider"
           TargetType="Slider">

		<Setter Property="Minimum"
                Value="-12"/>

		<Setter Property="Maximum"
                Value="12"/>

		<Setter Property="Value"
                Value="0"/>

		<Setter Property="Width"
                Value="30"/>

		<Setter Property="Orientation"
                Value="Vertical"/>

		<Setter Property="IsSnapToTickEnabled"
                Value="False"/>

		<Setter Property="Cursor"
                Value="Hand"/>

		<Setter Property="Template">

			<Setter.Value>

				<ControlTemplate TargetType="Slider">

					<Grid>

						<!-- Rail nền -->

						<Border Width="4"
                                HorizontalAlignment="Center"
                                Background="#F5DCEA"
                                CornerRadius="2"/>

						<!--
                            BUG FIX: bản cũ chỉ có 1 Thumb rời rạc thả thẳng vào Grid, KHÔNG có
                            Track (PART_Track) - vì vậy Slider không có cách nào nối chuyển động
                            kéo chuột với Value, kéo thumb không có tác dụng gì. Track là control
                            bắt buộc để WPF tự xử lý DragDelta -> cập nhật Value, và tự đặt vị trí
                            Thumb theo Value hiện tại. Cấu trúc này mượn lại đúng cách làm đã chạy
                            ổn ở PixelStyles.xaml/DarkTheme.xaml, chỉ đổi màu sắc cho khớp Pink.
                        -->
						<Track x:Name="PART_Track">

							<Track.DecreaseRepeatButton>
								<RepeatButton Command="Slider.DecreaseLarge"
                                              Background="Transparent" BorderThickness="0"/>
							</Track.DecreaseRepeatButton>

							<Track.IncreaseRepeatButton>
								<RepeatButton Command="Slider.IncreaseLarge"
                                              Background="Transparent" BorderThickness="0"/>
							</Track.IncreaseRepeatButton>

							<Track.Thumb>
								<Thumb x:Name="Thumb" Cursor="Hand">
									<Thumb.Template>
										<ControlTemplate TargetType="Thumb">
											<Border x:Name="ThumbBorder"
                                                    Width="20" Height="20"
                                                    Background="#FF2D78"
                                                    BorderBrush="#FFD2E5"
                                                    BorderThickness="2"
                                                    CornerRadius="10"/>
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="ThumbBorder" Property="Background" Value="#FF5C97"/>
												</Trigger>
												<Trigger Property="IsDragging" Value="True">
													<Setter TargetName="ThumbBorder" Property="Background" Value="#D91760"/>
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Thumb.Template>
								</Thumb>
							</Track.Thumb>

						</Track>

					</Grid>

				</ControlTemplate>

			</Setter.Value>

		</Setter>

	</Style>


	<!-- ===================== COMBOBOX ====================== -->

	<Style TargetType="ComboBox">

		<Setter Property="Foreground"
                Value="{StaticResource TextPrimary}"/>

		<Setter Property="Background"
                Value="{StaticResource BgElevated}"/>

		<Setter Property="BorderBrush"
                Value="{StaticResource BorderColor}"/>

		<Setter Property="BorderThickness"
                Value="1"/>

		<Setter Property="FontSize"
                Value="12"/>

		<Setter Property="FontFamily"
                Value="{StaticResource AppFont}"/>

		<Setter Property="Padding"
                Value="10,6"/>

	</Style>


	<!-- ===================== TEXTBOX ====================== -->

	<Style TargetType="TextBox">

		<Setter Property="Foreground"
                Value="{StaticResource TextPrimary}"/>

		<Setter Property="Background"
                Value="{StaticResource BgElevated}"/>

		<Setter Property="BorderBrush"
                Value="{StaticResource BorderColor}"/>

		<Setter Property="BorderThickness"
                Value="1"/>

		<Setter Property="FontFamily"
                Value="{StaticResource AppFont}"/>

		<Setter Property="Padding"
                Value="8,5"/>

	</Style>

	<!--
        ===== STEP 10 =====
        Style dưới đây trước STEP 7/10 nằm cục bộ trong MainWindow.xaml Window.Resources.
        Chuyển vào đây (và DarkTheme.xaml/PixelStyles.xaml) để 3 theme ngang hàng.
    -->

	<Style x:Key="HeaderIconButton" TargetType="Button">
		<Setter Property="Width" Value="34"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="Background" Value="{StaticResource BgElevated}"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentColorDim}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="DbAxisLabel" TargetType="TextBlock">
		<Setter Property="FontSize" Value="9"/>
		<Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
		<Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
		<Setter Property="Opacity" Value="0.6"/>
		<Setter Property="HorizontalAlignment" Value="Right"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="0,0,6,0"/>
	</Style>

	<Style x:Key="FreqTickLabel" TargetType="TextBlock">
		<Setter Property="FontSize" Value="9.5"/>
		<Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
		<Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
		<Setter Property="Opacity" Value="0.6"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
	</Style>

	<Style x:Key="NavTabButton" TargetType="Button">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="Transparent" Padding="6,4">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FilterEditorLabel" TargetType="TextBlock">
		<Setter Property="FontSize" Value="9.5"/>
		<Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
		<Setter Property="Margin" Value="0,0,0,4"/>
	</Style>

	<Style x:Key="FilterEditorValue" TargetType="TextBlock">
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
	</Style>

	<Style x:Key="FilterEditorTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
		<Setter Property="Height" Value="30"/>
		<Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
	</Style>

	<!-- ===== ListBox item cho PresetPanel (STEP 9) ===== -->
	<Style x:Key="PresetListBoxItem" TargetType="ListBoxItem">
		<Setter Property="Padding" Value="12,10"/>
		<Setter Property="Margin" Value="0,0,0,6"/>
		<Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
		<Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBoxItem">
					<Border x:Name="ItemBg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
						<ContentPresenter/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ItemBg" Property="BorderBrush" Value="#FF2D78"/>
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="ItemBg" Property="BorderBrush" Value="#FF2D78"/>
							<Setter TargetName="ItemBg" Property="BorderThickness" Value="2"/>
							<Setter TargetName="ItemBg" Property="Background" Value="{StaticResource AccentColorDim}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>